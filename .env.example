# ============================================================================
# HKU Teacher-student Co-learning (SOLO) Bot — environment configuration
# Copy to `.env` and fill in the values before `docker compose up -d`.
# NEVER commit the real .env (it contains secrets).
# ============================================================================

# ---- LLM API (Qwen / DashScope, OpenAI-compatible) --------------------------
# Required for answering & quiz generation. Get a key from Aliyun DashScope.
DASHSCOPE_API_KEY=
QWEN_API_MODEL=qwen-plus
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- Local data paths -------------------------------------------------------
# Defaults are <repo>/.data and <repo>/.uploads.
# RAG_DATA_DIR=.data
# RAG_UPLOAD_DIR=.uploads

# ---- Authentication ---------------------------------------------------------
# Force login on all API endpoints. Recommended: on for shared deployments.
# When RAG_REQUIRE_AUTH=1, users authenticate with username/password login tokens.
# Do NOT put that login token into RAG_ACCESS_TOKEN below.
RAG_REQUIRE_AUTH=1
# Login token lifetime in seconds (default 7 days).
RAG_AUTH_TOKEN_TTL=604800

# Optional static machine/service Bearer (scripts, pytest). Used ONLY when login
# auth is off (RAG_REQUIRE_AUTH=0). Ignored when login auth is enabled.
# RAG_ACCESS_TOKEN=
# RAG_REQUIRE_ACCESS_TOKEN=0

# Bootstrap admin/teacher account (created on first startup if it doesn't exist).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
ADMIN_DISPLAY_NAME=Course Teacher

# Initial student self-registration code (students enter this to create accounts).
# If left blank, a random code is generated; view/rotate it in the Teacher Console.
STUDENT_REGISTER_CODE=

# ---- Networking / CORS ------------------------------------------------------
# Host port to publish (container always listens on 8000).
HOST_PORT=8000
# Set to 1 to enforce the CORS allow-list below; default off (accepts any origin).
RAG_CORS_STRICT=0
RAG_ALLOWED_ORIGINS=

# ---- Limits & behaviour -----------------------------------------------------
RAG_MAX_FILES=5
RAG_MAX_FILE_MB=20
RAG_MAX_TOP_K=5
RAG_MAX_QUESTION_CHARS=1000
RAG_RATE_LIMIT_MAX_REQUESTS=120
RAG_RATE_LIMIT_WINDOW_SECONDS=60

# Keep derived vector cache across restarts (0 = keep, 1 = clear on shutdown).
RAG_CLEAR_CACHE_ON_SHUTDOWN=0

# ---- Embeddings / model hub -------------------------------------------------
# Use the official HuggingFace hub (1) or the default mirror (leave unset).
# RAG_USE_OFFICIAL_HF=1
# Do NOT load a local LLM in the container (API mode is used instead).
RAG_ENABLE_LOCAL_LLM=0

# Embedding model. Default is multilingual bge-m3 (8192-token context; good for
# English/bilingual courses). ~0.5B params (~2.3GB RAM); downloads on first run.
# Recommended for bilingual courses on 8GB CPU: multilingual-e5-small (~0.5GB).
# Avoid Chinese-only bge-small-zh when lecture notes are English (scores inflate on off-topic EN queries).
MS_EMBED_ID=intfloat/multilingual-e5-small
# Optional local weights path (applies to whatever MS_EMBED_ID is set; change both together):
# RAG_EMBED_MODEL_PATH=E:/For_RAG/.models/multilingual-e5-small
# Low-RAM encode batch (default 4; use 2 on 8GB machines):
# RAG_EMBED_BATCH_SIZE=2
# Chinese-only tiny model / GPU production upgrades:
#   MS_EMBED_ID=BAAI/bge-small-zh-v1.5
#   MS_EMBED_ID=BAAI/bge-m3

# ---- Retrieval quality (RAG optimizations) ---------------------------------
# Multi-query rewrite + HyDE (one extra LLM call per question). 1=on (default).
RAG_ENABLE_REWRITE=1
RAG_ENABLE_HYDE=1
# Cross-encoder reranking. 1=on (default). Downloads the reranker on first run;
# if it can't load, the pipeline safely falls back to fusion order.
RAG_ENABLE_RERANK=1
# On 8GB CPU with English lecture notes, prefer the local MiniLM (~90MB):
# RAG_RERANK_MODEL=E:/For_RAG/.models/ms-marco-MiniLM-L-6-v2
# Default multilingual reranker (good for English/bilingual courses).
# Alternatives: Alibaba-NLP/gte-multilingual-reranker-base (smaller/faster, set TRUST below),
#               cross-encoder/ms-marco-MiniLM-L-6-v2 (tiny, English-only).
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Set 1 if the reranker model requires custom code (e.g. gte / jina rerankers).
# RAG_RERANK_TRUST_REMOTE_CODE=0
# Contextual Retrieval: prepend a deterministic context header to each chunk. 1=on.
RAG_CONTEXTUAL_HEADERS=1
# Corrective single re-query (lightweight CRAG): if the first retrieval is weak,
# rewrite the query once and re-retrieve (hard cap = 1). Set RAG_CORRECTIVE_TRIGGER to override the threshold.
RAG_ENABLE_CORRECTIVE=1
# CRAG-style grounding gate thresholds (rerank mode uses 0..1 probability scores).
# RAG_RERANK_MIN_SCORE=0.05
# RAG_RERANK_SINGLE_HIT_MIN_SCORE=0.12
# RAG_RERANK_STRONG_SCORE=0.80
# RAG_RERANK_SINGLE_HIT_STRONG_SCORE=0.80
# RAG_RERANK_SECOND_HIT_SCORE=0.60
# RAG_RERANK_SUFFICIENCY_MARGIN=0.10
# Cosine-mode thresholds (used when rerank is off/unavailable).
# RAG_KB_MIN_SCORE=0.28
# RAG_KB_SINGLE_HIT_MIN_SCORE=0.40
# RAG_KB_STRONG_SCORE=0.62
# RAG_KB_SINGLE_HIT_STRONG_SCORE=0.75
# RAG_KB_SECOND_HIT_SCORE=0.62
# RAG_KB_SUFFICIENCY_MARGIN=0.08
# Borderline evidence gets one LLM sufficiency check before deciding RAG vs general knowledge.
RAG_ENABLE_SUFFICIENCY_JUDGE=1
# Minimum fraction of factual answer sentences carrying a valid [n] citation.
RAG_MIN_CITATION_COVERAGE=0.95
# Evidence refinement: drop chunks scoring below this ratio of the top hit.
# RAG_EVIDENCE_KEEP_RATIO=0.25
# Chunking (token budget, not characters; changing these invalidates the vector cache).
# RAG_CHUNK_TOKENS=480
# RAG_CHUNK_OVERLAP_RATIO=0.15
# RAG_CHUNK_TOKENS_TABULAR=640
# Chunks shorter than this are merged into a neighbour (headers, title-only slides).
# RAG_MIN_CHUNK_CHARS=120
# Parent unit (page/slide) is cached with the child chunk and expanded in the prompt when
# it fits this many characters; keep it aligned with RAG_PROMPT_CHUNK_CHAR_LIMIT.
# RAG_PARENT_MAX_CHARS=2400
# RAG_PROMPT_CHUNK_CHAR_LIMIT=2400
# Optional exact token counting for chunking (model name or local dir); default is an estimator.
# RAG_CHUNK_TOKENIZER=BAAI/bge-m3
# PDF pages exported as images (scans, handwritten formula slides) have no text layer and are
# invisible to retrieval; pages with fewer than MIN_CHARS extracted characters are rendered and
# sent to RapidOCR. Costs a few seconds per page, once, at index build time.
# RAG_PDF_OCR=1
# RAG_PDF_OCR_MIN_CHARS=50
# RAG_PDF_OCR_DPI=180
# RAG_PDF_OCR_MAX_PAGES=400
